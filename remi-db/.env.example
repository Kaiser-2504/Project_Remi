# Kết nối cho ứng dụng (hàm serverless trên Vercel) — Transaction pooler, cổng 6543.
# Lấy ở Supabase Dashboard -> Connect -> Transaction pooler. Thêm ?workaround=supabase-pooler.vercel ở cuối.
DATABASE_URL="postgres://postgres.<project-ref>:<mật-khẩu>@aws-<vùng>.pooler.supabase.com:6543/postgres?workaround=supabase-pooler.vercel"

# Kết nối TRỰC TIẾP cho migration (cổng 5432) — chỉ dùng trên máy/CI, KHÔNG đưa vào hàm.
# Lấy ở Supabase Dashboard -> Connect -> Direct connection.
DATABASE_URL_DIRECT="postgres://postgres:<mật-khẩu>@db.<project-ref>.supabase.co:5432/postgres"

# Tuỳ chọn: số kết nối tối đa mỗi instance (mặc định 1, hợp với serverless).
DB_POOL_MAX=1
