# Sao chép thành .env rồi chỉnh. Không bao giờ đưa file .env lên GitHub.

PORT=3000
NODE_ENV=production
# Nơi lưu cơ sở dữ liệu SQLite (trong Docker là /data, được gắn volume)
DATA_DIR=./data

# Đặt 1 nếu chạy sau proxy/HTTPS (Fly.io, Render, Nginx...) để lấy đúng IP và đặt cookie Secure
TRUST_PROXY=0
# Cookie chỉ gửi qua HTTPS. Mặc định tự bật khi NODE_ENV=production.
# Chạy thử production trên http://localhost thì đặt COOKIE_SECURE=0
# COOKIE_SECURE=0

# Đặt 0 để khoá đăng ký tài khoản mới (khi chỉ dùng cho gia đình)
ALLOW_REGISTRATION=1

# AI (lấy khóa tại console.anthropic.com). Mọi người dùng đều dùng AI để hiểu câu nói.
# Bắt buộc khi NODE_ENV=production (thiếu thì máy chủ không khởi động).
# Khi chạy thử ở máy bạn mà chưa có khóa: app vẫn mở, chỉ các nút tạo nhanh dùng được.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Số lần AI tối đa mỗi người mỗi ngày (chặn chi phí phát sinh)
AI_DAILY_LIMIT=60

# Thông báo đẩy. Để trống: máy chủ tự sinh khóa và lưu trong cơ sở dữ liệu.
# Muốn tự quản lý: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:ban@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------
# Bản Next.js trên Vercel + Supabase (đặt trong Vercel > Settings > Environment Variables)
# ---------------------------------------------------------------
# Chuỗi kết nối Transaction pooler (cổng 6543) của Supabase. Dùng cho ứng dụng.
DATABASE_URL=
# Chuỗi kết nối trực tiếp hoặc Session pooler (cổng 5432). Chỉ dùng ở máy bạn để chạy npm run db:migrate.
DATABASE_URL_DIRECT=
# Chuỗi bí mật dài, ngẫu nhiên. pg_cron gửi kèm khi gọi /api/cron/dispatch.
CRON_SECRET=
# Bản Vercel bắt buộc tự đặt cặp khoá VAPID (không có ổ đĩa để lưu): npx web-push generate-vapid-keys
