diff --git a/server/test/repo.test.js b/server/test/repo.test.js
index a50cf74..c795f60 100644
--- a/server/test/repo.test.js
+++ b/server/test/repo.test.js
@@ -17,3 +17,13 @@ test('.gitignore vẫn chặn bí mật và dữ liệu chạy thật', () => {
   const lines = fs.readFileSync(path.join(root, '.gitignore'), 'utf8').split('\n').map((l) => l.trim());
   for (const must of ['node_modules/', '.env', '*.sqlite']) assert.ok(lines.includes(must), 'thiếu ' + must);
 });
+
+test('npm start và npm run dev đọc tệp .env (máy chủ chỉ đọc process.env, không tự mở .env)', () => {
+  const scripts = JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8')).scripts;
+  for (const k of ['start', 'dev']) assert.match(scripts[k], /--env-file-if-exists=\.env/, `script ${k} phải nạp .env`);
+});
+
+test('.env.example không bật production mặc định (sao chép nguyên vẹn ra máy cá nhân sẽ khiến máy chủ đòi khóa AI và cookie Secure)', () => {
+  const lines = fs.readFileSync(path.join(root, '.env.example'), 'utf8').split('\n').map((l) => l.trim());
+  assert.ok(!lines.some((l) => /^NODE_ENV\s*=\s*production/.test(l)), 'dòng NODE_ENV=production phải được comment trong .env.example');
+});
