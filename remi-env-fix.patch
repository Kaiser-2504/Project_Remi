 # Sao chép thành .env rồi chỉnh. Không bao giờ đưa file .env lên GitHub.
 
 PORT=3000
-NODE_ENV=production
+# Chạy ở máy cá nhân: để dòng NODE_ENV dưới đây bị tắt (có dấu #). Khi triển khai thật thì bỏ dấu # để bật chế độ production
+# (khi đó thiếu ANTHROPIC_API_KEY là máy chủ không khởi động, và cookie chỉ gửi qua HTTPS). Docker đã tự đặt production.
+# NODE_ENV=production
 # Nơi lưu cơ sở dữ liệu SQLite (trong Docker là /data, được gắn volume)
 DATA_DIR=./data
 
